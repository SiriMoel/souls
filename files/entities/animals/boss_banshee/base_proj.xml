<Entity name="$projectile_default">

	<Base file="data/entities/base_projectile.xml">
		<VelocityComponent
    		gravity_y="0"
			air_friction="-0.1"
			mass="0.05"
		></VelocityComponent> 
	</Base>
	
	<HomingComponent
		target_tag="player_unit"
		homing_targeting_coeff="7"
		detect_distance="350"
		homing_velocity_multiplier="1.0"
	></HomingComponent>

    <ProjectileComponent 
        _enabled="1" 
	    lob_min="0.8"
  	    lob_max="1.0"
  	    speed_min="100"
  	    speed_max="120"
        die_on_low_velocity="0"
        on_death_explode="1"
        on_death_gfx_leave_sprite="0" 
        on_lifetime_out_explode="1"
	    explosion_dont_damage_shooter="1"
        damage="0.4"
        on_collision_die="0"
        bounces_left="10"
		bounce_at_any_angle="1"
		bounce_energy="1.3"
        lifetime="150"
        ><config_explosion
            never_cache="1" 
            camera_shake="0.5" 
            explosion_radius="1" 
            explosion_sprite="data/particles/explosion_040_poof_blue.xml" 
            explosion_sprite_lifetime="0.0" 
            create_cell_probability="1" 
            create_cell_material="souls_soul_particles_banshee" 
	        ray_energy="10000"
            hole_destroy_liquid="1" 
            hole_enabled="1" 
	        damage = "0.1"
            hole_image="data/temp/explosion_hole.png"
	        explosion_sprite_emissive="1"
	        explosion_sprite_additive="1"
            particle_effect="0" 
            damage_mortals="1"
	        physics_explosion_power.min="0" 
            physics_explosion_power.max="0"
	        physics_throw_enabled="0"
            shake_vegetation="1"  
            sparks_enabled="1" 
	        spark_material="souls_soul_particles_banshee"
            sparks_count_max="16" 
            sparks_count_min="12"
            light_fade_time="1.2" 
	        light_r="225"
	        light_g="255"
            light_b="255"
            stains_enabled="1" 
            stains_image="data/temp/explosion_stain.png"
        ></config_explosion>
    </ProjectileComponent>
  
    <SpriteComponent 
        _enabled="1" 
        image_file="mods/souls/files/entities/animals/boss_banshee/sprite_proj_1.xml"
        offset_x="5" 
        offset_y="5" 
        emissive="1"
        additive="1"
    	update_transform_rotation="0"
	></SpriteComponent>

	<HitEffectComponent 
        effect_hit="LOAD_UNIQUE_CHILD_ENTITY"
        value_string="mods/souls/files/entities/animals/boss_banshee/effect_proj.xml"
    ></HitEffectComponent>

    <ParticleEmitterComponent 
		_enabled="1"
		emitted_material_name="souls_soul_particles"
		gravity.y="0.0"
		lifetime_min="0.3"
		lifetime_max="0.5"
		x_vel_min="-3"
		x_vel_max="3"
		y_vel_min="-18"
		y_vel_max="-7"
		count_min="2"
		count_max="6"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		area_circle_radius.min="0"
		area_circle_radius.max="5"
		cosmetic_force_create="1"
		collide_with_grid="0"
		airflow_force="0.051"
		airflow_time="1.01"
		airflow_scale="0.03"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		emit_cosmetic_particles="1"
		is_emitting="1"
    ></ParticleEmitterComponent>
	
	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/souls/files/entities/animals/boss_banshee/base_proj.xml"
    ></VariableStorageComponent>

</Entity>