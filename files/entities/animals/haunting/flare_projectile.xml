<Entity name="$projectile_default">

  	<Base file="data/entities/base_projectile.xml" >
	    <VelocityComponent
    		gravity_y="200"
		  	air_friction="1.1"
    	  	mass="0.08"
		></VelocityComponent>
	</Base>

    <ProjectileComponent
        lob_min="0.5"
        lob_max="0.7"
        speed_min="500"
        speed_max="550"
        friction="1"
        direction_random_rad="0.01"
        on_death_explode="0"
        on_death_gfx_leave_sprite="0" 
        on_lifetime_out_explode="0"
        explosion_dont_damage_shooter="1"
        on_collision_die="1"
        lifetime="80"
        damage="0.24"
        velocity_sets_scale="1"
        lifetime_randomness="4"
        ragdoll_force_multiplier="0.04"
        hit_particle_force_multiplier="0.1"
  	    muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_launcher.xml"
        shoot_light_flash_r="60"
        shoot_light_flash_g="140"
        shoot_light_flash_b="120"
        shoot_light_flash_radius="72" 
      	knockback_force="0.3"
        physics_impulse_coeff="1500"
	></ProjectileComponent>
  
    <SpriteComponent 
        _enabled="1" 
        alpha="1" 
        image_file="mods/souls/files/entities/animals/haunting/sprite_flare.xml"
        next_rect_animation=""
        rect_animation="" 
        additive="1"
    ></SpriteComponent>
  
  	<ParticleEmitterComponent 
	  	emitted_material_name="souls_soul_particles"
		offset.x="0"
    	offset.y="0"
    	x_pos_offset_min="-1"
		x_pos_offset_max="1"
    	y_pos_offset_min="-1"
		y_pos_offset_max="1"
		x_vel_min="0"
    	x_vel_max="0"
	    y_vel_min="0"
    	y_vel_max="0"
	    gravity.y="0.0"
		count_min="1"
		count_max="3"
    	lifetime_min="0.5"
	    lifetime_max="0.9"
    	is_trail="1"
	    trail_gap="1.0"
		render_on_grid="1"
		fade_based_on_lifetime="1"
    	airflow_force="0.5"
	    airflow_time="0.001"
    	airflow_scale="0.0833"
	    emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		emit_cosmetic_particles="1"
    	create_real_particles="0"
	    is_emitting="1"
    ></ParticleEmitterComponent>
	
    <AudioComponent
        file="data/audio/Desktop/projectiles.bank"
        event_root="player_projectiles/bullet_fire_heavy">
    </AudioComponent>
  
    <LightComponent
		_enabled="1" 
        radius="40" 
  	    r="60"
      	g="140"
      	b="120"
    ></LightComponent>
  
  	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/souls/files/entities/animals/haunting/flare_projectile.xml"
	></VariableStorageComponent>

</Entity>