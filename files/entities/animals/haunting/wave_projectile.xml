<Entity name="$projectile_default">

  	<Base file="data/entities/base_projectile.xml" >
	      <VelocityComponent
    		    gravity_y="0"
		  	    air_friction="0.5"
    	  	  mass="0.01"
    		></VelocityComponent>
	  </Base>

    <ProjectileComponent
        lob_min="0.5"
        lob_max="0.7"
        speed_min="500"
        speed_max="550"
        friction="1"
        direction_random_rad="0.01"
        on_death_explode="0"
        on_death_gfx_leave_sprite="0" 
        on_lifetime_out_explode="0"
        explosion_dont_damage_shooter="1"
        on_collision_die="0"
        lifetime="16"
        damage="0.04"
        velocity_sets_scale="1"
        lifetime_randomness="0"
        ragdoll_force_multiplier="0.04"
        hit_particle_force_multiplier="0.1"
        shoot_light_flash_r="60"
        shoot_light_flash_g="140"
        shoot_light_flash_b="120"
        shoot_light_flash_radius="72" 
      	knockback_force="3.2"
        physics_impulse_coeff="1500"
	  ></ProjectileComponent>
  
    <SpriteComponent 
        _enabled="1" 
        image_file="mods/souls/files/entities/animals/haunting/sprite_wave.xml"
    ></SpriteComponent>
  
  	<AudioComponent
        file="data/audio/Desktop/projectiles.bank"
        event_root="player_projectiles/bullet_fire_heavy"
	  ></AudioComponent>
  
    <LightComponent
		    _enabled="1" 
        radius="40" 
  	    r="60"
      	g="140"
      	b="120"
    ></LightComponent>
  
  	<VariableStorageComponent
		    name="projectile_file"
    		value_string="mods/souls/files/entities/animals/haunting/wave_projectile.xml"
	  ></VariableStorageComponent>

</Entity>