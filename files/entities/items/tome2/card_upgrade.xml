<Entity>
	
	<Base file="data/entities/base_custom_card.xml" > 
		<SpriteComponent 
			image_file="mods/souls/files/spell_icons/tome_upgrade.png"
			>
		</SpriteComponent>
		
		<ItemActionComponent 
			_tags="enabled_in_world"
			action_id="MOLDOS_UPGRADE_TOME" >
		</ItemActionComponent>
	</Base>

	<InheritTransformComponent
		_tags="enabled_in_world,enabled_in_hand" >
	</InheritTransformComponent>

	<LuaComponent 
		_tags="enabled_in_hand"
		script_source_file="mods/souls/files/entities/items/tome2/card_upgrade.lua"
		execute_every_n_frame="1" >
	</LuaComponent>

    <VariableStorageComponent
		_tags="upgrade"
        name="upgrade"
        value_int="1"
    ></VariableStorageComponent>

	<VariableStorageComponent
		_tags="frame_cd"
        name="frame_cd"
        value_int="0"
    ></VariableStorageComponent>

	<SpriteComponent
		_enabled="0"
		_tags="tome_upgrade_cost"
		image_file="data/fonts/font_pixel_white.xml"
		is_text_sprite="1"
		offset_x="20"
		offset_y="20"
		update_transform="1"
		update_transform_rotation="0"
		has_special_scale="1"
		special_scale_x="0.6"
		special_scale_y="0.6"
		text="Upgrade: 5 souls"
		z_index="-1"
	></SpriteComponent>

</Entity>