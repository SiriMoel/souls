<Entity name="$projectile_default" tags="projectile_player,soul_projectile">

	<Base file="data/entities/base_projectile.xml">
    	<VelocityComponent
			    gravity_y="0"
			    air_friction="1.0"
			    mass="0.00"
			></VelocityComponent>
	</Base>

    <ProjectileComponent
        lob_min="0.6"
        lob_max="0.8"
        speed_min="0"
        speed_max="0"
        friction="1"
        direction_random_rad="0.01"
        on_death_explode="0"
        on_death_gfx_leave_sprite="0" 
        on_lifetime_out_explode="0"
        on_collision_die="0"
        lifetime="6"
        penetrate_entities="1"
        penetrate_world="1"
        damage="0"
        velocity_sets_scale="1"
        lifetime_randomness="0"
        ragdoll_force_multiplier="0.04"
        hit_particle_force_multiplier="0.1"
	    muzzle_flash_file=""
        shoot_light_flash_r="120"
        shoot_light_flash_g="255"
        shoot_light_flash_b="80"
        shoot_light_flash_radius="72" 
	    knockback_force="1.4"
        physics_impulse_coeff="1500"
    ></ProjectileComponent>

    <ParticleEmitterComponent 
		emitted_material_name="souls_soul_particles"
		gravity.y="0.0"
		lifetime_min="0.6"
		lifetime_max="0.9"
		x_vel_min="0"
		x_vel_max="0"
		y_vel_min="0"
		y_vel_max="0"
		count_min="120"
		count_max="120"
		render_on_grid="1"
		fade_based_on_lifetime="0"
		area_circle_radius.min="1"
		area_circle_radius.max="170"
		cosmetic_force_create="1"
		collide_with_grid="0"
		airflow_force="0.051"
		airflow_time="1.01"
		airflow_scale="0.03"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		emit_cosmetic_particles="1"
		velocity_always_away_from_center="2"
		is_emitting="1" 
    ></ParticleEmitterComponent>

    <LuaComponent
        script_source_file="mods/souls/files/entities/projectiles/tome_field/proj.lua"
        execute_every_n_frame="2"
    ></LuaComponent>
  
    <LightComponent 
        radius="40" 
      	r="100"
      	g="255"
      	b="255"
    ></LightComponent>
  
	<VariableStorageComponent
    	name="projectile_file"
    	value_string="mods/souls/files/entities/projectiles/tome_field/proj.xml"
	></VariableStorageComponent>

</Entity>