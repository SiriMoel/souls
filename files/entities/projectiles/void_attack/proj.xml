<Entity name="$projectile_default" tags="projectile_player,soul_projectile">

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			mass="0.0"
			>
		</VelocityComponent>
	</Base>

  <ProjectileComponent 
    _enabled="1" 
    lob_min="0"
    lob_max="0"
    speed_min="400"
    speed_max="500"
    friction="0.0"
    direction_random_rad="0"
    on_death_explode="0"
    on_death_gfx_leave_sprite="0" 
    on_lifetime_out_explode="0"
    ground_collision_fx="1"
    on_collision_die="0"
    penetrate_entities="1"
    lifetime="16"
    damage="0"
    lifetime_randomness="0"
    ragdoll_force_multiplier="0.01"
    hit_particle_force_multiplier="0.25"
    >
    <damage_by_type
			melee="0"
      slice="0"
			>
		</damage_by_type>
  </ProjectileComponent>
  
  <AudioComponent
      file="data/audio/Desktop/projectiles.bank"
      event_root="player_projectiles/destruction">
  </AudioComponent>

  <SpriteComponent 
    _enabled="1" 
    alpha="1" 
    image_file="mods/souls/files/entities/projectiles/void_attack/sprite.xml" 
    next_rect_animation=""
    rect_animation="" 
     >
  </SpriteComponent>

    <HitEffectComponent
        effect_hit="LOAD_UNIQUE_CHILD_ENTITY"
        value_string="mods/souls/files/entities/misc/reapers/reap_entity.xml"
    ></HitEffectComponent>

    <LuaComponent
  		script_source_file="mods/souls/files/entities/projectiles/void_attack/proj.lua"
		  execute_every_n_frame="2"
		  >
	  </LuaComponent>

    <LuaComponent
  		  script_source_file="mods/souls/files/entities/projectiles/void_attack/create.lua"
		    execute_on_added="1"
        remove_after_executed="1"
		></LuaComponent>

  	<GameAreaEffectComponent
        radius="50"
        collide_with_tag="hittable"
        frame_length="1"
    ></GameAreaEffectComponent>
  
    <VariableStorageComponent
		name="projectile_file"
		value_string="mods/souls/files/entities/projectiles/void_attack/proj.xml"
		>
	</VariableStorageComponent>
</Entity>

